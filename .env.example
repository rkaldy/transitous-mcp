# Povinný kontakt provozovatele (e-mail nebo URL) pro User-Agent Transitous.
TRANSITOUS_CONTACT=mailto:you@example.com
MAX_WALK_SECONDS=900
WALK_SPEED_MPS=1.2
HOST=127.0.0.1
PORT=8000
# Pro veřejné HTTPS nasazení přidejte vlastní doménu:
ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","[::1]:*"]
ALLOWED_ORIGINS=["http://localhost:*","http://127.0.0.1:*","https://chatgpt.com"]
